set_location_assignment PIN_G21 -to CLOCK_50
set_location_assignment PIN_H2  -to KEY0
set_location_assignment PIN_G3  -to step_btn
set_location_assignment PIN_J6  -to run_debug

set_location_assignment PIN_J1 -to LED_N
set_location_assignment PIN_J2 -to LED_Z
set_location_assignment PIN_E1 -to LED_HLT

set_location_assignment PIN_F13 -to HEX0[6]
